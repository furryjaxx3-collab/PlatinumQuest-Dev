new MaterialProperty(LowBounceFloorMaterial) {
   friction = 1;
   restitution = 1;
   force = 5;
};

new MaterialProperty(MedBounceFloorMaterial) {
   friction = 1;
   restitution = 1;
   force = 10;
};
new MaterialProperty(HighBounceFloorMaterial) {
   friction = 1;
   restitution = 1;
   force = 15;
};
addMaterialMapping( "Bounce1" , LowBounceFloorMaterial);
addMaterialMapping( "Bounce2" , MedBounceFloorMaterial);
addMaterialMapping( "Bounce3" , HighBounceFloorMaterial);



new MaterialProperty(mudFrictionMaterial) {
    friction = 0.4;
    restitution = 0.1;
};

new MaterialProperty(rampFrictionMaterial) {
    friction = 3;
    restitution = 0.3;
};

new MaterialProperty(grassFrictionMaterial) {
    friction = 2.5;
    restitution = 0.12;
};

new MaterialProperty(sandFrictionMaterial) {
    friction = 4;
    restitution = 0;
};

new MaterialProperty(waterFrictionMaterial) {
    friction = 5;
    restitution = 0;
};
new MaterialProperty(NoFrictionMaterial) {
    friction = 0;
    restitution = 0;
};

new MaterialProperty(SuperHighFrictionMaterial) {
    friction = 1000;
    restitution = 0;
};
new MaterialProperty(IceMaterial) {
    friction = 0.2;
    restitution = 1;
};
addMaterialMapping("friction_none" , NoFrictionMaterial);
addMaterialMapping("super_friction" , SuperHighFrictionMaterial);
addMaterialMapping( "friction_low2" ,    IceFrictionMaterial);
addMaterialMapping( "friction_low" ,    MudFrictionMaterial);
addMaterialMapping( "friction_high" ,    grassFrictionMaterial);
addMaterialMapping( "friction_ramp_yellow" ,    RampFrictionMaterial);
addMaterialMapping( "golf_grass" ,    grassFrictionMaterial);
addMaterialMapping( "golf_sand" ,    sandFrictionMaterial);
addMaterialMapping( "golf_water" ,    waterFrictionMaterial);
addMaterialMapping( "Water_blueescent" ,    waterFrictionMaterial);
addMaterialMapping( "Water_cyanescent" ,    waterFrictionMaterial);
addMaterialMapping( "Water_greenscent" ,    waterFrictionMaterial);
addMaterialMapping( "Water_pinkscent" ,    waterFrictionMaterial);
addMaterialMapping( "Water_redscent" ,    waterFrictionMaterial);
