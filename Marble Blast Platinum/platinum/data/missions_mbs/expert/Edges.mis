new MaterialProperty(WaterFrictionMaterial) {
   friction = 5;
   restitution = 0;
};

new MaterialProperty(ZeroFrictionMaterial) {
   friction = 0.00;
   restitution = 0.4;
};

new MaterialProperty(HighFrictionMaterial) {
   friction = 1.50;
   restitution = 0.5;
};

new MaterialProperty(DarknessMaterial) {
   friction = 1;
   restitution = 1;
   force = 101;
};

addMaterialMapping( "MBGIce" ,    ZeroFrictionMaterial);
addMaterialMapping( "MBGWater" ,    WaterFrictionMaterial);
addMaterialMapping( "MBGGrass" ,    HighFrictionMaterial);
addMaterialMapping( "blackplate" ,    DarknessMaterial);

